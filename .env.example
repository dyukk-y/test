# === Обязательные ===
# Токен от @BotFather. НИКОГДА не публикуйте его и не коммитьте файл .env
BOT_TOKEN=
# Telegram ID владельцев бота через запятую (узнать свой ID: @userinfobot)
OWNER_IDS=

# === Необязательные ===
# Часовой пояс района (для тихих часов, прогноза и бэкапов)
TIMEZONE=Asia/Novosibirsk
# Папка для базы, логов, бэкапов, сессий
DATA_DIR=data

# Сбор из Telegram-каналов: получите на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Премиум за Telegram Stars: 1 — включён, 0 — все функции бесплатны
PREMIUM_ENABLED=1
# Тарифы «дней:звёзд» через запятую
PREMIUM_PLANS=7:50,30:150,365:990

# Куда дополнительно отправлять ежедневный бэкап (ID или @канал, бот должен быть админом)
BACKUP_CHAT_ID=

# User-Agent для OpenStreetMap Nominatim (по правилам OSM — название вашего приложения)
NOMINATIM_USER_AGENT=dps-guardian-bot/3.0

# Прокси для Telegram API, если api.telegram.org недоступен напрямую: http://host:port или socks5://user:pass@host:port
TELEGRAM_PROXY=

# Мини-апп (карта в Telegram): HTTPS-адрес страницы docs/index.html.
# Для GitHub Pages: Settings → Pages → Deploy from a branch → main, /docs
WEBAPP_URL=https://dyukk-y.github.io/test/

# Живой мини-апп (свой сервер с доменом): встроенный веб-сервер отдаёт страницу и API.
# С docker compose --profile web: DOMAIN=ваш-домен, WEBAPP_PORT=8080, WEBAPP_URL=https://ваш-домен/
DOMAIN=
WEBAPP_PORT=
# Если страница лежит в другом месте (например GitHub Pages), а API — на вашем сервере:
WEBAPP_API=
